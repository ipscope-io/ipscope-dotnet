<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>IpScope.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>IPScope Engineering</Authors>
    <Description>Official zero-dependency, type-safe Sync &amp; Async .NET Server-Side SDK for the IPScope IP Intelligence Platform.</Description>
    <PackageTags>ip;geolocation;asn;vpn-detection;ip-intelligence;ipscope</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
